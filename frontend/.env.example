# Copy this file to .env.local and paste your keys there (.env.local is never committed).
# Supabase dashboard → Project Settings → API (or "Connect" → App Frameworks):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only if Flask runs on ANOTHER domain. On Vercel (one project, /api on the same domain) leave it unset:
# VITE_API_BASE_URL=https://your-flask-host.example.com
